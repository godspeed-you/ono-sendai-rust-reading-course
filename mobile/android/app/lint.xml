<?xml version="1.0" encoding="UTF-8"?>
<!-- Android lint policy (lint runs with abortOnError). Every suppression is explained. -->
<lint>
    <!-- res/xml/config.xml is generated by `cap sync` (Cordova compatibility layer) and read by
         name at runtime, so lint cannot see its use. -->
    <issue id="UnusedResources">
        <ignore path="src/main/res/xml/config.xml" />
    </issue>
    <!-- The launch-screen icon is specified by Android at 240dp (splash icon area). -->
    <issue id="VectorRaster">
        <ignore path="src/main/res/drawable/splash_mark.xml" />
    </issue>
    <!-- Toolchain versions (Gradle, AGP, AndroidX) are pinned deliberately with Capacitor and
         updated together with it; "newer version available" depends on the day lint runs and on
         network access, which would make CI results non-reproducible. -->
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
</lint>
